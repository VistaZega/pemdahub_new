APP_NAME="Pembda Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pembda_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Configuration (Dual Provider: Fonnte & Baileys)
# Active provider bisa diswitch via browser: /switch-wa-provider?secret=pembda99
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=fonnte
WHATSAPP_SENDER=088991144184

# Provider A: Fonnte (Berbayar, cocok production)
FONNTE_API_URL=https://api.fonnte.com
FONNTE_API_TOKEN=your_fonnte_api_token_here

# Provider B: Self-Hosted Baileys (Gratis, butuh Node.js)
BAILEYS_API_URL=http://localhost:3000
BAILEYS_API_TOKEN=y7xhSUrJ37wpRykg15kc

# Error Alert Notifications (Telegram & WhatsApp)
ERROR_ALERTS_ENABLED=true
ERROR_ALERT_COOLDOWN_MINUTES=5
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
WHATSAPP_ALERT_ENABLED=false
WHATSAPP_ALERT_PHONE=

# Jitsi Meet Configuration
JITSI_DOMAIN=meet.jit.si

FIREBASE_SERVER_KEY=
FIREBASE_PROJECT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
